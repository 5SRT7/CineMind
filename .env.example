# TMDB
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_LANGUAGE=zh-CN
# TMDB 默认地址被网络阻断时，可改成你自己的反向代理或镜像地址
TMDB_API_BASE_URL=
# 代理示例：Clash / Surge 等本地代理
TMDB_PROXY=
HTTPS_PROXY=

# AI Provider: auto / openai / siliconflow
AI_PROVIDER=auto

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# SiliconFlow (硅基流动)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# 向量维度：OpenAI text-embedding-3-small 为 1536；SiliconFlow bge-m3 为 1024
EMBEDDING_DIMENSIONS=1024

# Neon PostgreSQL + pgvector (optional; falls back to in-memory TTL cache)
DATABASE_URL=
PGVECTOR_ENABLED=true
WATCHLIST_USER_KEY=default

# App
AI_SEARCH_TOP_K=12
AI_SEARCH_TTL_HOURS=24
NEXT_PUBLIC_SITE_URL=http://localhost:3000
